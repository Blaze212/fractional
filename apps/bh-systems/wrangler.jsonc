{
  // Static marketing site for bh-systems. Deploy: `npx wrangler deploy` from this folder.
  // Only ./public is served — the ui/ component library is never uploaded.
  "name": "bh-systems",
  "compatibility_date": "2026-06-03",
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application"
  }
}
