{
  // Static marketing site for bh-systems, plus a thin proxy at /texml/gas that
  // fronts the adjuster app's Apps Script deployment (see src/worker.js — Apps
  // Script's /exec endpoint always 302s to script.googleusercontent.com, which
  // Telnyx's TeXML fetches don't follow). Deploy: `npx wrangler deploy` from
  // this folder. Only ./public is served as static assets — the ui/ component
  // library is never uploaded.
  //
  // GAS_EXEC_URL is a Worker secret (`wrangler secret put GAS_EXEC_URL`), not
  // a var — it carries the live Apps Script deploy ID and stays out of git,
  // same convention the checked-in TeXML files use for DEPLOY_ID/SECRET.
  "name": "bh-systems",
  "compatibility_date": "2026-06-03",
  "main": "./src/worker.js",
  // run_worker_first: without it, Cloudflare's static-asset/SPA-fallback layer
  // answers /texml/gas directly (GET gets index.html, POST gets a bare 405)
  // and src/worker.js's fetch() handler — the actual proxy to Apps Script —
  // never runs. Scoped to just this path so the rest of the site still serves
  // as plain static assets.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/texml/gas"],
  },
  // Workers Logs — every invocation (plus console.error output like the
  // proxy failure log in src/worker.js) shows up in the dashboard's Logs tab
  // and via `wrangler tail`, without needing a tail session running live.
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
}
