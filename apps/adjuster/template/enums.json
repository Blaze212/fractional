    "label": "Mortgage status",
    "type": "variant",
    "section": "Mortgage",
    "required": true,
    "values": [
      {
        "key": "has_mortgage",
        "label": "Has a mortgage",
        "text": "I confirmed with the insured that their mortgage is through {{mortgage_company}}."
      },
      {
        "key": "no_mortgage",
        "label": "No mortgage",
        "text": "I confirmed with the insured that there is not a mortgage on the property."
      }
    ]
  },
  "mortgage_company": {
    "label": "Mortgage company",
