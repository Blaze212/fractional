  "loss_cause": {
    "label": "Loss cause (short phrase, e.g. \"storm\", \"wind\", \"lightning\")",
    "type": "string",
    "section": "Coverage",
    "required": true
  },
  "coverage_determination": {
    "label": "Coverage determination",
    "type": "variant",
    "section": "Coverage",
    "required": true,
    "values": [
      {
        "key": "storm_covered_no_concerns",
        "label": "Covered, no concerns",
        "text": "The damages to the insured's property are {{loss_cause}} related, which is covered under the insured's policy. Therefore, there are no coverage concerns that would affect this claim."
      },
      {
        "key": "storm_covered_interior_excluded",
        "label": "Exterior covered, interior excluded",
        "text": "The damages to the insured's property are {{loss_cause}} related, which is covered under the insured's policy. However, the interior water damage was not caused by a storm-created opening. Therefore, there are no coverage concerns for the exterior of the dwelling, however coverage would not apply to the interior as it was not a direct result of a storm-created opening."
      },
      {
        "key": "accidental_discharge_covered",
        "label": "Accidental discharge, covered",
        "text": "The damages to the insured's property are related to an accidental discharge of water from within a plumbing system, which is covered under the insured's policy. Therefore, there are no coverage concerns that would affect this claim."
      },
      {
        "key": "coverage_issue",
        "label": "Coverage issue / denial",
        "text": "There is a coverage issue affecting this claim that requires carrier review before further handling proceeds."
      }
    ]
  },
