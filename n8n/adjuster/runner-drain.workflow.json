{
  "name": "Adjuster — pipeline drain",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "68ce2a5e-6cc7-44d6-8c26-b6adc7b7d551",
      "name": "Every 15 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [0, 96]
    },
    {
      "parameters": {
        "url": "https://www.bh-systems.com/texml/gas",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "event",
              "value": "runner_drain"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          },
          "timeout": 660000
        }
      },
      "id": "8783c000-15a6-40c7-bf90-f3dfcaa984e4",
      "name": "Drain the pipeline",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [224, 96],
      "credentials": {
        "httpQueryAuth": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Adjuster WEBHOOK_SECRET (t)"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 1
          },
          "conditions": [
            {
              "id": "drain-reported-ok",
              "leftValue": "={{ $json.ok }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "dc85c599-3f6d-43d6-bd74-d8d394f9cd50",
      "name": "Did the drain report ok?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [448, 96]
    },
    {
      "parameters": {},
      "id": "5d088cf8-4621-4e9a-99fa-55e68741cd40",
      "name": "Drained",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [672, 0]
    },
    {
      "parameters": {
        "errorMessage": "=Adjuster drain did not report ok. stopped_because={{ $json.stopped_because || \"n/a\" }} body={{ JSON.stringify($json).slice(0, 500) }}"
      },
      "id": "ba4aa31c-e494-4798-8dc5-d9cbbfb5244b",
      "name": "Alert — drain failed",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [672, 192]
    }
  ],
  "connections": {
    "Every 15 minutes": {
      "main": [[{ "node": "Drain the pipeline", "type": "main", "index": 0 }]]
    },
    "Drain the pipeline": {
      "main": [[{ "node": "Did the drain report ok?", "type": "main", "index": 0 }]]
    },
    "Did the drain report ok?": {
      "main": [
        [{ "node": "Drained", "type": "main", "index": 0 }],
        [{ "node": "Alert — drain failed", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
